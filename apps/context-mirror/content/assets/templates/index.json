      "placeholders": [
        {"key": "DATE",        "kind": "text"},
        {"key": "RECIPIENT_NAME", "kind": "text"},
        {"key": "RECIPIENT_TITLE","kind": "text"},
        {"key": "RECIPIENT_COMPANY","kind": "text"},
        {"key": "RECIPIENT_ADDRESS","kind": "text"},
        {"key": "GREETING",    "kind": "text", "example": "Dear [Name],"},
        {"key": "BODY",        "kind": "rich"},
        {"key": "SIGNOFF",     "kind": "text", "default": "Sincerely,"},
        {"key": "SENDER_NAME", "kind": "text"},
        {"key": "SENDER_TITLE","kind": "text"},
        {"key": "SENDER_MOBILE","kind": "text"},
        {"key": "SENDER_EMAIL","kind": "text"}
      ]
    },
