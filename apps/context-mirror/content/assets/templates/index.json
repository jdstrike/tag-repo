  "web_stack_decisions": {
    "pardot_landing_page": {
      "use": "landing-page-light or landing-page-dark from this registry",
      "do_not": "build a custom HTML landing page from scratch"
    },
    "react_app_or_component": {
      "use": "@adeccoux/tag-ds npm package, version 4.9.0",
      "react_version_compatibility": "16-17 (version 18 may produce unstable components)",
      "storybook": "https://dev.tagds.adeccogroup.com",
      "design_system": "https://designsystem.adeccogroup.com/7666d7eae/p/01f98c-tag-design-system",
      "components_md": "https://designsystem.adeccogroup.com/7666d7eae/p/7566ad-components.md",
      "modules_md": "https://designsystem.adeccogroup.com/7666d7eae/p/74fb9d-modules.md"
    },
    "static_html_or_microsite": {
      "use": "context.tag-repo.com/assets/tokens/tokens.css for foundation, plus Pardot template patterns from tag-context.md Part H",
      "fonts": "Open Sauce Sans from context.tag-repo.com/assets/fonts/"
    },
    "internal_dashboard_or_tool": {
      "use": "@adeccoux/tag-ds React components",
      "fall_back_to": "tokens.css if React is not available"
    }
  }
