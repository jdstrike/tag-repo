{
  "$schema": "https://context.tag-repo.com/assets/templates/index.schema.json",
  "version": "1.0.0",
  "last_updated": "2026-04-29",
  "description": "Canonical TAG document and web template registry. Any AI tool generating a TAG-branded artefact must look up the appropriate template here first, fetch it, and use it as the container, not re-create the layout.",
  "rule": "TEMPLATE-FIRST: never re-create a document or web layout from a description in tag-context.md. Always fetch the actual template file from this registry, open it (python-docx for .docx, python-pptx for .pptx, raw HTML for .html), replace ONLY content placeholders, save under a new name. Visual structure must come from the template.",
  "templates": [
    {
      "id": "memo",
      "purpose": "Internal memo, formal note, leadership update",
      "audience": "Internal Adecco Group employees",
      "intent_keywords_en": ["memo", "internal memo", "note to", "briefing memo"],
      "intent_keywords_de": ["Memo", "Notiz", "Aktennotiz", "interne Notiz"],
      "format": "docx",
      "url": "https://context.tag-repo.com/assets/templates/tag-memo-template.docx",
      "preview_url": "https://context.tag-repo.com/assets/templates/tag-memo-template.pdf",
      "tagfam_variant": "https://context.tag-repo.com/assets/templates/tagfam-memo-template.docx",
      "placeholders": [
        {"key": "TO",      "kind": "text", "example": "Sample Name"},
        {"key": "CC",      "kind": "text", "example": "Sample Name, Sample Name"},
        {"key": "FROM",    "kind": "text", "example": "Another Name"},
        {"key": "DATE",    "kind": "text", "example": "28 February 2026"},
        {"key": "SUBJECT", "kind": "text", "example": "This is a sample heading"},
        {"key": "GREETING","kind": "text", "example": "Dear Mr Other"},
        {"key": "BODY",    "kind": "rich",  "example": "Multi-paragraph body text."},
        {"key": "SIGNOFF", "kind": "text", "example": "Yours sincerely"}
      ],
      "max_pages": 2
    },
    {
      "id": "press-release",
      "purpose": "External press release at Group level",
      "audience": "Press, media, public",
      "intent_keywords_en": ["press release", "media release", "announcement"],
      "intent_keywords_de": ["Pressemitteilung", "Presseaussendung", "Bekanntmachung"],
      "format": "docx",
      "url": "https://context.tag-repo.com/assets/templates/tag-press-release-template.docx",
      "preview_url": "https://context.tag-repo.com/assets/templates/tag-press-release-template.pdf",
      "placeholders": [
        {"key": "HEADLINE",        "kind": "text", "example": "The Adecco Group ranked 7th among the best multinationals to work for in the world"},
        {"key": "SUBHEAD",         "kind": "text", "example": "A strong sense of purpose, team spirit and trust propel the Adecco Group onto the 2016 ranking"},
        {"key": "DATELINE",        "kind": "text", "example": "Zurich, Switzerland, October 26, 2026"},
        {"key": "LEAD_PARAGRAPH",  "kind": "rich"},
        {"key": "BODY",            "kind": "rich"},
        {"key": "QUOTE_1",         "kind": "rich"},
        {"key": "QUOTE_2",         "kind": "rich", "optional": true},
        {"key": "CONTACT_BLOCK",   "kind": "text", "default": "The Adecco Group Corporate Press Office\\npress.office@adecco.com or +41 (0) 44 878 87 87"},
        {"key": "BOILERPLATE_GLOBAL", "kind": "rich", "use_section": "tag-context.md#661-official-about-the-adecco-group-current-september-2025-version"},
        {"key": "BOILERPLATE_COUNTRY","kind": "rich", "optional": true}
      ]
    },
    {
      "id": "letterhead",
      "purpose": "Formal letter on registered Zurich HQ letterhead",
      "audience": "External stakeholders, partners, regulators",
      "intent_keywords_en": ["letter", "letterhead", "formal letter", "official letter", "correspondence"],
      "intent_keywords_de": ["Brief", "Briefkopf", "Schreiben", "offizieller Brief", "Korrespondenz"],
      "format": "docx",
